#!/usr/bin/env python3
"""foodnomsctl-bridge — generate the Shortcut that foodnomsctl writes through.

macOS has no command that invokes another app's App Intent directly. The only
supported path is a Shortcut, so writes go through exactly one generated
Shortcut: the CLI hands it a JSON request, it dispatches on a `command` key to
the matching FoodNoms intent, and returns the intent's result.

One Shortcut rather than one per intent, because installing a suite of twelve is
a chore and they would drift apart. Generated rather than hand-built, because a
dispatcher is N branches of hand-wired parameters and that is precisely the
shape that rots — the branch set is data in intents.yaml, and rebuilding re-emits
all of it consistently.

Two things this deliberately does NOT do. It does not write to the FoodNoms
store: the store is CloudKit-mirrored, so a row inserted behind the app's back
gets no CKRecord and never syncs. And it does not bind entity-typed parameters,
which Shortcuts resolves through picker UI with no headless equivalent.

  foodnomsctl-bridge [--manifest intents.yaml] [--out <path>] [--publish]
"""
import argparse
import os
import plistlib
import re
import subprocess
import sys
import time
import uuid
from datetime import datetime

HERE = os.path.dirname(os.path.abspath(__file__))
CLIENT_VERSION = "2700.0.4"
BUILDER_VERSION = "1.0"

# Shortcuts' condition codes. 4 is "is" — exact equality. 99 is "contains", and
# using it for dispatch is how a branch for "Maca" also fires for "Macadamia
# Milk"; every comparison here is exact for that reason.
COND_IS = 4

# WFControlFlowMode: 0 opens a block, 1 is the else, 2 closes it.
FLOW_OPEN, FLOW_CLOSE = 0, 2


def load_manifest(path):
    try:
        import yaml
    except ImportError:
        sys.exit("PyYAML required: pip3 install pyyaml")
    with open(path) as fh:
        return yaml.safe_load(fh)


def action(ident, params):
    return {"WFWorkflowActionIdentifier": ident, "WFWorkflowActionParameters": params}


# Shortcuts has three different serializations for "the output of an earlier
# action", and using the wrong one renders as a red "Unknown Variable" rather
# than failing the import. A plain WFInput takes the attachment directly; a
# conditional's WFInput wants it wrapped in a Variable; a text field wants it as
# an attachment positioned in a string.

def output_ref(out_uuid, name):
    """Direct form — what a normal action's WFInput expects."""
    return {"WFSerializationType": "WFTextTokenAttachment",
            "Value": {"OutputName": name, "OutputUUID": out_uuid,
                      "Type": "ActionOutput"}}


def condition_ref(out_uuid, name):
    """What a conditional's WFInput expects — and it is its own shape.

    Two things are load-bearing and neither errors on import. The Variable
    wrapper sits at the top level with no WFSerializationType above it — wrap it
    like a normal attachment and the If renders bare, with no input at all. And
    a generic output such as "Dictionary Value" needs the string coercion, or
    the If renders its input but leaves the comparison value empty; a text-typed
    output would not need it, which is why a working example without one is
    misleading.
    """
    return {"Type": "Variable",
            "Variable": {"WFSerializationType": "WFTextTokenAttachment",
                         "Value": {"Aggrandizements": [
                             {"CoercionItemClass": "WFStringContentItem",
                              "Type": "WFCoercionVariableAggrandizement"}],
                             "OutputName": name, "OutputUUID": out_uuid,
                             "Type": "ActionOutput"}}}


def var_token(out_uuid, name):
    """The same reference, but as the whole of a text field."""
    return {"WFSerializationType": "WFTextTokenString",
            "Value": {"string": "￼",
                      "attachmentsByRange": {
                          "{0, 1}": {"OutputName": name, "OutputUUID": out_uuid,
                                     "Type": "ActionOutput"}}}}


def shortcut_input():
    return {"WFSerializationType": "WFTextTokenAttachment",
            "Value": {"Type": "ExtensionInput"}}


def descriptor(bundle, intent, team):
    d = {"AppIntentIdentifier": intent, "BundleIdentifier": bundle, "Name": "Foodnoms"}
    if team:
        d["TeamIdentifier"] = team
    return d


APP_INTENTS_METADATA = ("/Applications/FoodNoms.app/Contents/Resources"
                       "/Metadata.appintents/extract.actionsdata")


def required_params(intent):
    """What the installed app says this intent cannot run without.

    Shortcuts validates every action in a workflow before running any of them,
    so one action missing a required parameter makes the whole bridge fail —
    including commands that are themselves complete. The failure surfaces at run
    time as "Please choose a value for each parameter in this action", with no
    indication of which action is at fault, so it is worth catching at build.
    """
    import json
    try:
        with open(APP_INTENTS_METADATA) as fh:
            meta = json.load(fh)
    except (OSError, ValueError):
        return None
    spec = meta.get("actions", {}).get(intent)
    if not spec:
        return None
    return [p["name"] for p in spec.get("parameters", []) if not p.get("isOptional")]


def check_commands(commands):
    """Dispatch is exact, but duplicate command names would still make the
    second branch unreachable. Refuse to emit rather than ship a dead branch."""
    seen = {}
    for c in commands:
        name = c["command"]
        if name in seen:
            sys.exit(f"duplicate command {name!r} in manifest")
        seen[name] = True

        req = required_params(c["intent"])
        if req is None:
            continue
        supplied = (set(c.get("fixed") or {}) | set(c.get("params") or {})
                    | set(c.get("entities") or {}))
        # An intent can declare a parameter required and still run without it:
        # the Shortcuts editor writes out only what the user set, so the app's
        # own default applies. Naming such a parameter is what breaks the
        # action. `omit_required` records that this was a decision rather than
        # an oversight, and which parameter it was.
        supplied |= set(c.get("omit_required") or [])
        missing = [r for r in req if r not in supplied]
        if missing:
            sys.exit(f"{c['intent']} ({name}): required parameter(s) not supplied: "
                     f"{', '.join(missing)}. Add them to intents.yaml under `fixed` "
                     "or `params`, or drop the command — an entity-typed one "
                     "(mealType, foodMeasure) cannot be supplied at all.")


def build(manifest):
    bundle = manifest["bundle"]
    commands = manifest["commands"]
    check_commands(commands)

    stamp = datetime.now().strftime("%Y.%m.%d.%H%M")
    names = ", ".join(c["command"] for c in commands)
    acts = [action("is.workflow.actions.comment", {"WFCommentActionText": (
        f"FoodNomsCTL Bridge v{stamp} — generated by foodnomsctl-bridge "
        f"{BUILDER_VERSION} from intents.yaml. Do not edit actions by hand; "
        "regenerate, or the next build silently reverts the edit.\n\n"
        "The write path for foodnomsctl. Takes a JSON request as input, "
        "dispatches on its `command` key, and calls the matching FoodNoms App "
        "Intent. Writing to the FoodNoms store directly is not an option — it "
        "is CloudKit-mirrored, so a row inserted behind the app never syncs.\n\n"
        f"Commands: {names}")})]

    DICT_OUT, VALUE_OUT = "Dictionary", "Dictionary Value"

    dict_uuid, cmd_uuid = str(uuid.uuid4()).upper(), str(uuid.uuid4()).upper()
    acts.append(action("is.workflow.actions.detect.dictionary", {
        "UUID": dict_uuid, "WFInput": shortcut_input()}))
    acts.append(action("is.workflow.actions.getvalueforkey", {
        "UUID": cmd_uuid, "WFDictionaryKey": "command",
        "WFGetDictionaryValueType": "Value",
        "WFInput": output_ref(dict_uuid, DICT_OUT)}))

    for spec in commands:
        group = str(uuid.uuid4()).upper()
        acts.append(action("is.workflow.actions.conditional", {
            "GroupingIdentifier": group, "UUID": str(uuid.uuid4()).upper(),
            "WFControlFlowMode": FLOW_OPEN, "WFCondition": COND_IS,
            "WFConditionalActionString": spec["command"],
            "WFInput": condition_ref(cmd_uuid, VALUE_OUT)}))

        params = dict(spec.get("fixed") or {})

        # An entity parameter is not a string: Shortcuts wants a dict carrying
        # both the identifier and the text to show for it. Supplying that is why
        # entity-typed parameters ARE bindable after all — the picker is only
        # unavoidable when there is no identifier to hand it.
        for key, spec_e in (spec.get("entities") or {}).items():
            ident, label = str(uuid.uuid4()).upper(), str(uuid.uuid4()).upper()
            acts.append(action("is.workflow.actions.getvalueforkey", {
                "UUID": ident, "WFDictionaryKey": spec_e["identifier"],
                "WFGetDictionaryValueType": "Value",
                "WFInput": output_ref(dict_uuid, DICT_OUT)}))
            acts.append(action("is.workflow.actions.getvalueforkey", {
                "UUID": label, "WFDictionaryKey": spec_e["display"],
                "WFGetDictionaryValueType": "Value",
                "WFInput": output_ref(dict_uuid, DICT_OUT)}))
            entity = {"identifier": var_token(ident, VALUE_OUT),
                      "displayString": var_token(label, VALUE_OUT)}
            params[key] = [entity] if spec_e.get("array") else entity

        for key in (spec.get("params") or {}):
            pu = str(uuid.uuid4()).upper()
            acts.append(action("is.workflow.actions.getvalueforkey", {
                "UUID": pu, "WFDictionaryKey": key,
                "WFGetDictionaryValueType": "Value",
                "WFInput": output_ref(dict_uuid, DICT_OUT)}))
            params[key] = var_token(pu, VALUE_OUT)

        intent_uuid = str(uuid.uuid4()).upper()
        params["UUID"] = intent_uuid
        # Without this the action shows its own sheet and waits — the delete
        # branch put up a confirmation modal that has to be dismissed by hand,
        # which defeats the point of a headless write path. It is not the
        # intent's `deleteWithoutConfirmation`, which was already set: that is
        # FoodNoms', this one is the Shortcuts action's.
        params["ShowWhenRun"] = False
        params["AppIntentDescriptor"] = descriptor(bundle, spec["intent"],
                                                   manifest.get("team"))
        acts.append(action(f"{bundle}.{spec['intent']}", params))

        # An intent that returns entities returns nothing a caller can read: the
        # workflow result is the entity array, and writing that to a text file
        # produces an empty file. `after` appends actions that turn it into
        # something legible, or feed it to a second intent — which is the only
        # way to reach an entity-typed parameter at all, since Shortcuts binds
        # those from another action's output but never from a string.
        prev_uuid, prev_name = intent_uuid, spec.get("result_name", "Food Entries")
        for step in (spec.get("after") or []):
            su = str(uuid.uuid4()).upper()
            if step["do"] == "count":
                acts.append(action("is.workflow.actions.count", {
                    "UUID": su, "WFCountType": "Items",
                    "WFInput": output_ref(prev_uuid, prev_name)}))
                prev_uuid, prev_name = su, "Count"
            elif step["do"] == "text":
                acts.append(action("is.workflow.actions.gettext", {
                    "UUID": su, "WFTextActionText": var_token(prev_uuid, prev_name)}))
                prev_uuid, prev_name = su, "Text"
            elif step["do"] == "item":
                # One entity out of the list, by position. Position rather than
                # name because Shortcuts' filter actions do not see an entity's
                # properties, and the caller resolves the index against the very
                # list this action re-fetches — `entries` returns it in the same
                # order — so the index is checked rather than assumed.
                idx = str(uuid.uuid4()).upper()
                acts.append(action("is.workflow.actions.getvalueforkey", {
                    "UUID": idx, "WFDictionaryKey": step["index_key"],
                    "WFGetDictionaryValueType": "Value",
                    "WFInput": output_ref(dict_uuid, DICT_OUT)}))
                acts.append(action("is.workflow.actions.getitemfromlist", {
                    "UUID": su, "WFItemSpecifier": "Item At Index",
                    "WFItemIndex": var_token(idx, VALUE_OUT),
                    "WFInput": output_ref(prev_uuid, prev_name)}))
                prev_uuid, prev_name = su, "Item from List"
            elif step["do"] == "intent":
                # The point of the whole chain: an entity-typed parameter is
                # unreachable from a string but binds from another action's
                # output. This is the only shape that can delete.
                p2 = dict(step.get("fixed") or {})
                # A chained intent may need the request's own fields too, not
                # just the entity it is being handed: logging with a meal type
                # is GetMealType -> pick one -> Log, and the Log is where the
                # food and its macros go.
                for key in (step.get("params") or []):
                    ku = str(uuid.uuid4()).upper()
                    acts.append(action("is.workflow.actions.getvalueforkey", {
                        "UUID": ku, "WFDictionaryKey": key,
                        "WFGetDictionaryValueType": "Value",
                        "WFInput": output_ref(dict_uuid, DICT_OUT)}))
                    p2[key] = var_token(ku, VALUE_OUT)
                p2[step["param"]] = output_ref(prev_uuid, prev_name)
                p2["UUID"] = su
                p2["ShowWhenRun"] = False
                p2["AppIntentDescriptor"] = descriptor(bundle, step["intent"],
                                                       manifest.get("team"))
                acts.append(action(f"{bundle}.{step['intent']}", p2))
                prev_uuid, prev_name = su, step.get("result_name", "Result")
            else:
                sys.exit(f"unknown `after` step: {step['do']!r}")

        acts.append(action("is.workflow.actions.conditional", {
            "GroupingIdentifier": group, "UUID": str(uuid.uuid4()).upper(),
            "WFControlFlowMode": FLOW_CLOSE}))

    return {
        "WFWorkflowActions": acts,
        "WFWorkflowClientVersion": CLIENT_VERSION,
        "WFWorkflowHasOutputFallback": False,
        "WFWorkflowHasShortcutInputVariables": True,
        "WFWorkflowIcon": {"WFWorkflowIconGlyphNumber": 59511,
                           "WFWorkflowIconStartColor": 4292093695},
        "WFWorkflowImportQuestions": [],
        "WFWorkflowInputContentItemClasses": ["WFStringContentItem",
                                              "WFDictionaryContentItem"],
        "WFWorkflowMinimumClientVersion": 900,
        "WFWorkflowMinimumClientVersionString": "900",
        "WFWorkflowName": manifest["shortcut_name"],
        "WFWorkflowOutputContentItemClasses": [],
        "WFWorkflowTypes": [],
    }


def verify(workflow):
    """Every opened conditional must close, or Shortcuts refuses the import
    with an error that says nothing about which branch is at fault."""
    depth = 0
    for a in workflow["WFWorkflowActions"]:
        if a["WFWorkflowActionIdentifier"] == "is.workflow.actions.conditional":
            mode = a["WFWorkflowActionParameters"].get("WFControlFlowMode")
            depth += 1 if mode == FLOW_OPEN else -1 if mode == FLOW_CLOSE else 0
            if depth < 0:
                sys.exit("control flow: a block closed that was never opened")
    if depth:
        sys.exit(f"control flow: {depth} block(s) left open")


# ------------------------------------------------------------ the folder
#
# Filing the bridge into a Shortcuts folder needs a RootNavigationDestination
# entity, and entities bind from a literal identifier or another action's
# output, never from a name. There is no action that returns an existing
# folder (CreateFolderAction returns one, and refuses a name that exists), so
# the identifier has to be read. It is not in ZCOLLECTION — that entity is
# abandoned — but in the single Library record, whose ZDATA is a "crdt"
# document: a protobuf with a string table, a value table, and ops keyed by
# object id. Each folder is an object whose id is a UUID string and whose
# `name` register is a string-table ref. Pairing those is all this needs.
SHORTCUTS_DB = os.path.expanduser("~/Library/Shortcuts/Shortcuts.sqlite")
UUID_RE = re.compile(r"^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$", re.I)


def _library_connection():
    """A read-only connection to a snapshot of the library, WAL included.

    `shortcuts list` and a bare copy of the file both read from the last
    checkpoint and can be a day stale; copying the -wal alongside is what makes
    a just-finished import visible. Never opened in place: the file is
    CloudKit-mirrored and a lock held on it is not worth the risk.
    """
    import shutil, tempfile, sqlite3
    if not os.path.exists(SHORTCUTS_DB):
        return None
    tmp = tempfile.mkdtemp(prefix="fnbridge.lib.")
    dst = os.path.join(tmp, "db.sqlite")
    shutil.copy2(SHORTCUTS_DB, dst)
    if os.path.exists(SHORTCUTS_DB + "-wal"):
        shutil.copy2(SHORTCUTS_DB + "-wal", dst + "-wal")
    return sqlite3.connect(dst)


def library_workflows():
    """{name: workflow id} for every live Shortcut."""
    con = _library_connection()
    if con is None:
        return {}
    try:
        return {n: w for n, w in con.execute(
            "SELECT ZNAME, ZWORKFLOWID FROM ZSHORTCUT WHERE ZTOMBSTONED = 0 AND ZNAME IS NOT NULL")}
    finally:
        con.close()


def _varint(b, i):
    r = s = 0
    while i < len(b):
        x = b[i]; i += 1
        r |= (x & 0x7f) << s; s += 7
        if not x & 0x80:
            return r, i
        if s > 63:
            break
    raise ValueError("bad varint")


def _fields(b):
    """One protobuf message as [(field, wiretype, value)], schema-free."""
    i, out = 0, []
    while i < len(b):
        key, i = _varint(b, i)
        f, wt = key >> 3, key & 7
        if f == 0 or f > 5000:
            raise ValueError("not a message")
        if wt == 0:
            v, i = _varint(b, i)
        elif wt == 1:
            v = b[i:i + 8]; i += 8
        elif wt == 5:
            v = b[i:i + 4]; i += 4
        elif wt == 2:
            n, i = _varint(b, i)
            if n > len(b) - i:
                raise ValueError("truncated")
            v = b[i:i + n]; i += n
        else:
            raise ValueError("unsupported wire type")
        out.append((f, wt, v))
    return out


def folder_identifiers(blob=None):
    """{folder name: identifier} from the Library CRDT document.

    Layout, found by walking it: top-level field 6 is the document, holding a
    replica id (1), the string table (repeated 2) and the value table (repeated
    3). Top-level field 4 is repeated ops; an op's field 5 carries its object id
    as an inline `0x01 + text` value, and a register set to a string is a
    singleton sub-message `{3: <string table index>}`. A folder object is the
    one whose name register resolves to its display name.
    """
    if blob is None:
        con = _library_connection()
        if con is None:
            return {}
        try:
            row = con.execute("SELECT ZDATA FROM ZLIBRARY").fetchone()
        finally:
            con.close()
        if not row:
            return {}
        blob = row[0]
    if blob[:4] != b"crdt":
        return {}
    top = _fields(blob[8:])
    doc = next((v for f, wt, v in top if f == 6 and wt == 2), None)
    if doc is None:
        return {}
    strs = [v.decode("utf-8", "replace") for f, wt, v in _fields(doc) if f == 2]
    workflows = set(library_workflows().values())
    names = {}

    def object_id(msg):
        for f, wt, v in msg:
            if f == 5 and wt == 2:
                try:
                    for sf, swt, sv in _fields(v):
                        if sf == 2 and swt == 2 and sv[:1] == b"\x01":
                            t = sv[1:].decode("utf-8", "replace")
                            if UUID_RE.match(t):
                                return t.upper()
                except ValueError:
                    pass
        return None

    def walk(b, obj):
        try:
            fs = _fields(b)
        except ValueError:
            return
        if len(fs) == 1 and fs[0][0] == 3 and fs[0][1] == 0 and fs[0][2] < len(strs):
            names.setdefault(obj, set()).add(strs[fs[0][2]])
        for f, wt, v in fs:
            if wt == 2:
                walk(v, obj)

    for f, wt, v in top:
        if f != 4 or wt != 2:
            continue
        try:
            msg = _fields(v)
        except ValueError:
            continue
        obj = object_id(msg)
        if not obj or obj in workflows:
            continue
        for mf, mwt, mv in msg:
            if mf == 4 and mwt == 2:
                walk(mv, obj)

    out = {}
    for obj, ns in names.items():
        for n in ns:
            out.setdefault(n, set()).add(obj)
    # A name that resolves to exactly one non-workflow object is a folder.
    return {n: next(iter(ids)) for n, ids in out.items() if len(ids) == 1}


FILER_PREFIX = "ZZ Filer"


def build_filer(name, bridge_name, bridge_id, folder_name, folder_id, sweep):
    """A one-shot Shortcut that files the bridge and sweeps up older filers.

    Single-use by nature: the bridge's workflow id is assigned at import, so
    the move can only be written after the bridge exists, as a literal. Each
    filer also deletes the previous ones, so the steady state is exactly one.
    """
    stamp = datetime.now().strftime("%Y.%m.%d.%H%M")
    acts = [action("is.workflow.actions.comment", {
        "UUID": str(uuid.uuid4()).upper(),
        "WFCommentActionText": (
            f"{name} v{stamp} — moves \"{bridge_name}\" into the \"{folder_name}\" "
            "folder, then deletes earlier filers. Both the Shortcut and the "
            "folder are written in as literal entities: the folder identifier "
            "comes from the Shortcuts Library record, because no action returns "
            "an existing folder and a name will not bind.\n\nGenerated by "
            "foodnomsctl-bridge — regenerate, do not hand-edit.")})]
    acts.append({"WFWorkflowActionIdentifier": "com.apple.shortcuts.MoveShortcutToFolderAction",
                 "WFWorkflowActionParameters": {
                     "UUID": str(uuid.uuid4()).upper(), "ShowWhenRun": False,
                     "AppIntentDescriptor": {"BundleIdentifier": "com.apple.shortcuts",
                                             "Name": "Shortcuts",
                                             "AppIntentIdentifier": "MoveShortcutToFolderAction"},
                     "shortcuts": [{"identifier": bridge_id, "displayString": bridge_name}],
                     # Not the `identifier`/`displayString` envelope the Shortcut
                     # entity above accepts. An App Intents entity literal is
                     # title/subtitle/identifier — the shape the editor writes when
                     # a folder is picked by hand — and the identifier is the bare
                     # collection UUID. The displayString envelope with the same
                     # UUID falls straight through to the folder picker.
                     "folder": {"title": {"key": folder_name},
                                "subtitle": {"key": folder_name},
                                "identifier": folder_id}}})
    if sweep:
        acts.append({"WFWorkflowActionIdentifier": "com.apple.shortcuts.DeleteWorkflowAction",
                     "WFWorkflowActionParameters": {
                         "UUID": str(uuid.uuid4()).upper(), "ShowWhenRun": False,
                         "entities": [{"identifier": w, "displayString": n} for n, w in sweep]}})
    return {"WFWorkflowActions": acts, "WFWorkflowClientVersion": CLIENT_VERSION,
            "WFWorkflowHasOutputFallback": False, "WFWorkflowHasShortcutInputVariables": False,
            "WFWorkflowIcon": {"WFWorkflowIconGlyphNumber": 59511,
                               "WFWorkflowIconStartColor": 4282601983},
            "WFWorkflowImportQuestions": [], "WFWorkflowInputContentItemClasses": [],
            "WFWorkflowMinimumClientVersion": 900, "WFWorkflowMinimumClientVersionString": "900",
            "WFWorkflowName": name, "WFWorkflowOutputContentItemClasses": [],
            "WFWorkflowTypes": []}


def install_signed(workflow, name):
    """Sign and import a workflow; True once the library shows it."""
    import shutil, tempfile
    tmp = tempfile.mkdtemp(prefix="fnbridge.filer.")
    staged = os.path.join(tmp, name + ".staged.shortcut")
    signed = os.path.join(tmp, name + ".shortcut")
    with open(staged, "wb") as fh:
        plistlib.dump(workflow, fh)
    subprocess.run(["shortcuts", "sign", "--mode", "anyone", "-i", staged, "-o", signed],
                   check=False, capture_output=True)
    if not os.path.exists(signed) or os.path.getsize(signed) == 0:
        return False
    # Importing is not silent: `open` puts up an "Add Shortcut" preview window
    # and nothing installs until it is confirmed. Left alone, previews stack
    # invisibly and every later import lands behind them. Confirm it the way
    # bin/delete-bridge-build does — wait for the window count to rise, then
    # send Return to the frontmost window, which is the preview's default
    # button. Only when a window actually appeared: a Return into the editor
    # is a keystroke into someone's shortcut.
    before = window_count()
    subprocess.run(["open", "-a", "Shortcuts", signed], check=False)
    for _ in range(8):
        time.sleep(1)
        if library_holds(name):
            return True
        if window_count() > before:
            subprocess.run(["osascript", "-e", 'tell application "Shortcuts" to activate',
                            "-e", "delay 0.5",
                            "-e", 'tell application "System Events" to keystroke return'],
                           capture_output=True)
            break
    for _ in range(10):
        time.sleep(2)
        if library_holds(name):
            return True
    return False


def window_count():
    out = subprocess.run(["osascript", "-e",
                          'tell application "System Events" to tell process "Shortcuts" to count windows'],
                         capture_output=True, text=True)
    try:
        return int(out.stdout.strip() or 0)
    except ValueError:
        return 0


def file_bridge(bridge_name, folder_name):
    """Move an installed bridge into a folder, headlessly. Returns a message."""
    folders = folder_identifiers()
    folder_id = folders.get(folder_name)
    if not folder_id:
        return (f'no folder named "{folder_name}" in the Shortcuts library '
                f"(have: {', '.join(sorted(folders)) or 'none readable'})")
    wf = library_workflows()
    bridge_id = wf.get(bridge_name)
    if not bridge_id:
        return f'"{bridge_name}" is not in the library, so there is nothing to file'
    sweep = [(n, w) for n, w in wf.items() if n.startswith(FILER_PREFIX)]
    name = f"{FILER_PREFIX} {datetime.now():%m%d%H%M}"
    if not install_signed(build_filer(name, bridge_name, bridge_id, folder_name, folder_id, sweep), name):
        return (f'"{name}" did not import, so the bridge was not filed. An open '
                "Shortcuts editor window, a locked screen, or a freshly relaunched "
                "Shortcuts all swallow imports silently; retry in a minute.")
    try:
        subprocess.run(["shortcuts", "run", name], capture_output=True, text=True, timeout=30)
    except subprocess.TimeoutExpired:
        subprocess.run(["pkill", "-f", f"shortcuts run {name}"], capture_output=True)
        return f'"{name}" ran but did not return — a picker may be up, which means the folder did not bind'
    return f'filed "{bridge_name}" into "{folder_name}" (via {name})'


def library_holds(name):
    """Whether the Shortcuts library holds one by this name.

    Not `shortcuts list`. The library is a WAL-mode database and both that
    command and a plain copy of the file read a snapshot from the last
    checkpoint, which can be a day stale — which is how two imports that had in
    fact succeeded were written up as a total failure to import anything.
    Copying the -wal alongside it is what makes a just-finished import visible.
    """
    import shutil, sqlite3, tempfile
    src = os.path.expanduser("~/Library/Shortcuts/Shortcuts.sqlite")
    if not os.path.exists(src):
        return False
    tmp = tempfile.mkdtemp(prefix="fnbridge.lib.")
    dst = os.path.join(tmp, "db.sqlite")
    try:
        shutil.copy2(src, dst)
        for ext in ("-wal", "-shm"):
            if os.path.exists(src + ext):
                shutil.copy2(src + ext, dst + ext)
        con = sqlite3.connect(f"file:{dst}?mode=ro", uri=True)
        row = con.execute("SELECT 1 FROM ZSHORTCUT WHERE ZNAME = ? LIMIT 1",
                          (name,)).fetchone()
        con.close()
        return bool(row)
    except Exception:
        return False
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def main():
    ap = argparse.ArgumentParser(prog="foodnomsctl-bridge", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--manifest", default=os.path.join(HERE, "intents.yaml"))
    ap.add_argument("--out", default=os.path.join(HERE, "FoodNomsCTL Bridge.xml"))
    ap.add_argument("--name", help="override the stamped Shortcut name")
    ap.add_argument("--no-folder", action="store_true",
                    help="skip filing the bridge into its folder after install")
    ap.add_argument("--file", metavar="BRIDGE",
                    help="only file an already-installed bridge into the folder, then exit")
    ap.add_argument("--folders", action="store_true",
                    help="print the folders the library exposes, then exit")
    ap.add_argument("--publish", action="store_true",
                    help="also sign it and open it so Shortcuts imports it")
    a = ap.parse_args()

    manifest = load_manifest(a.manifest)
    if a.folders:
        for n, i in sorted(folder_identifiers().items()):
            print(f"  {i}  {n}")
        return
    if a.file:
        print(file_bridge(a.file, manifest.get("folder", "Nutrition")))
        return
    # Stamp every build. Importing never replaces a same-named Shortcut — it is
    # refused, or lands beside the old one — and the `shortcuts` CLI cannot
    # delete, so a fixed name means a rebuild silently keeps answering with the
    # old actions. A stamped name makes an upgrade just a rebuild, and the CLI
    # dispatches to the highest stamp it can see.
    if not a.name:
        manifest["shortcut_name"] = (
            f"{manifest['shortcut_name'].rstrip('0123456789 ')} "
            f"{datetime.now():%Y.%m.%d.%H%M}")
    else:
        manifest["shortcut_name"] = a.name
    workflow = build(manifest)
    verify(workflow)

    with open(a.out, "wb") as fh:
        plistlib.dump(workflow, fh)
    n = len(workflow["WFWorkflowActions"])
    print(f"{n} actions, {len(manifest['commands'])} commands → {a.out}")

    if a.publish:
        # `shortcuts sign` rejects any input path not ending in .shortcut,
        # whatever the file contains, and exits 0 even when it fails — so stage
        # a copy under the right name and check the output rather than $?.
        import shutil, tempfile
        tmp = tempfile.mkdtemp()
        staged = os.path.join(tmp, manifest["shortcut_name"] + ".shortcut")
        shutil.copy2(a.out, staged)
        signed = os.path.join(HERE, manifest["shortcut_name"] + ".shortcut")
        subprocess.run(["shortcuts", "sign", "--mode", "anyone",
                        "-i", staged, "-o", signed], check=False)
        shutil.rmtree(tmp, ignore_errors=True)
        if not os.path.exists(signed) or os.path.getsize(signed) == 0:
            sys.exit("signing produced no file")
        print(f"signed → {signed}")

        # `open -a Shortcuts`, never a bare `open`. A bare one hands the file to
        # LaunchServices, which returns 0 having installed nothing, and -600
        # when Shortcuts is not already running. Naming the app is the whole
        # difference between a silent no-op and an install.
        subprocess.run(["open", "-a", "Shortcuts", signed], check=False)

        # Importing does not replace a same-named Shortcut, it is refused, and
        # the `shortcuts` CLI cannot delete. So a rebuild under the canonical
        # name installs nothing and the old build keeps answering. Verify rather
        # than assume.
        import time
        time.sleep(6)
        name = manifest["shortcut_name"]
        if library_holds(name):
            print(f'installed → "{name}"')
            if not a.no_folder:
                print(file_bridge(name, manifest.get("folder", "Nutrition")))
        else:
            print(f'NOT installed: "{name}" is not in the library. If a Shortcut '
                  "of that name is already there, the import was refused — "
                  "publish under a different name and point FOODNOMSCTL_BRIDGE "
                  "at it.")


if __name__ == "__main__":
    main()
