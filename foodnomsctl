#!/usr/bin/env python3
"""foodnomsctl — the FoodNoms CLI for macOS and AI agents.

FoodNoms keeps its data in a local GRDB (SQLite) database inside the app's
sandbox container. Every logged entry is denormalized — it carries the food's
name, brand, barcode, unit, serving measure and full nutrition — which makes the
log itself the library: anything ever scanned or logged is queryable here,
offline, with no API and no account.

Read-only by design. The store is snapshotted before every read so a running
FoodNoms.app never contends on the write-ahead log, and nothing is ever written
back: the store is CloudKit-mirrored, so a row inserted behind the app's back
would never sync. Writes go through FoodNoms' own App Intents, dispatched by a
generated bridge Shortcut.

  foodnomsctl catalog [--min-count N] [--since YYYY-MM-DD]
  foodnomsctl search <term>
  foodnomsctl resolve <term|barcode:NNN|id:FOODID>
  foodnomsctl day [YYYY-MM-DD]
  foodnomsctl meals [name]
  foodnomsctl resolve-meal <name>
  foodnomsctl doctor

  foodnomsctl log <name> [--date WHEN] [--calories N] [--protein N] [--fat N]
  foodnomsctl create-food <name> [--brand B] [--barcode B] [--calories N] ...
  foodnomsctl delete <entry-id|name> [--on YYYY-MM-DD]
  foodnomsctl goal

--json on any subcommand.
"""
import argparse
import glob
import json
import os
import plistlib
import shutil
import sqlite3
import subprocess
import sys
import tempfile
import time
import uuid
from datetime import date, datetime, timezone

BUNDLE = "com.algebraiclabs.foodnoms"
# Importing a Shortcut does not replace a same-named one already in the library
# — it is refused outright, so a rebuilt bridge cannot be installed over the old
# one. Overriding the name is how a new build gets tested before it takes over.
# Version the name, because a Shortcut cannot be replaced. Importing does not
# overwrite a same-named one — it is refused — and the `shortcuts` CLI cannot
# delete, so the only way to ship a build that adds a command is under a name
# nothing holds yet. The old "FoodNomsCTL Bridge" stays in the library, answering
# with whatever it was built from; nothing dispatches to it any more.
BRIDGE = os.environ.get("FOODNOMSCTL_BRIDGE", "FoodNomsCTL Bridge 3")

# FoodNoms has moved its store twice. The Core Data one in the app group
# container stops in 2022 and the group-container GRDB copy stops in 2025; both
# are still on disk and both look plausible. The live store is in the app's
# sandbox container, whose directory name is a random UUID that differs per
# machine — so it has to be discovered, never hardcoded.
LEGACY = [
    os.path.expanduser(f"~/Library/Group Containers/group.{BUNDLE}/FoodNoms.sqlite"),
    os.path.expanduser(f"~/Library/Group Containers/group.{BUNDLE}/{BUNDLE}/db.db"),
]


def find_store():
    """The db.db belonging to FoodNoms' sandbox container."""
    pattern = os.path.expanduser("~/Library/Containers/*/Data/Documents/db.db")
    for path in glob.glob(pattern):
        container = path.split("/Data/")[0]
        meta = os.path.join(container, ".com.apple.containermanagerd.metadata.plist")
        try:
            with open(meta, "rb") as fh:
                identity = plistlib.load(fh)
        except OSError:
            continue
        if BUNDLE in str(identity.get("MCMMetadataIdentifier", "")):
            return path
    return None


def connect(path=None):
    store = path or find_store()
    if not store:
        sys.exit("FoodNoms store not found — is FoodNoms installed and has it run once?")
    tmp = tempfile.mkdtemp(prefix="foodnomsctl.")
    dst = os.path.join(tmp, "db.db")
    shutil.copy2(store, dst)
    for ext in ("-wal", "-shm"):
        if os.path.exists(store + ext):
            shutil.copy2(store + ext, dst + ext)
    con = sqlite3.connect(f"file:{dst}?mode=ro", uri=True)
    con.row_factory = sqlite3.Row
    return con


MACROS = ("protein", "carbs", "fat", "fiber", "sugars", "sodium")


def nutrients(row):
    """Macros as actually eaten, not per base amount.

    The `nutrients` JSON is per `baseAmount` of `baseUnit` — 100g, 15ml, one
    serving — while the entry records how much was eaten in whatever unit the
    user picked. Scaling by quantity x measure.value only works when that unit
    IS the base unit; log a tablespoon of a per-100g food and it is out by a
    factor of ten, which is how a tablespoon of chia seeds becomes 486 kcal.

    The `calories` column already holds the scaled figure, so the ratio between
    it and the per-base calories gives the factor for every other macro, with no
    unit conversion table to get wrong.
    """
    try:
        n = json.loads(row["nutrients"] or "{}")
    except (ValueError, TypeError):
        n = {}
    eaten = row["calories"]
    base = n.get("calories")

    if base and eaten is not None:
        factor = eaten / base
    else:
        # Zero-calorie foods (water, creatine) give no ratio to work from. Fall
        # back to the direct calculation, which is exact when the units agree.
        m = json.loads(row["measure"] or "{}") if row["measure"] else {}
        if m.get("unit") == row["baseUnit"] and row["baseAmount"]:
            factor = (row["quantity"] or 1) * (m.get("value") or 1) / row["baseAmount"]
        else:
            factor = row["quantity"] or 1

    out = {"calories": eaten if eaten is not None else (base or 0) * factor}
    for k in MACROS:
        v = n.get(k)
        out[k] = round(v * factor, 2) if v is not None else None
    return out


def measure_of(row):
    try:
        m = json.loads(row["measure"] or "{}")
    except (ValueError, TypeError):
        m = {}
    return m.get("unit") or row["baseUnit"], m.get("value")


ENTRY_COLS = """
  entryID, name, brandOwner, barcode, foodID, baseUnit, baseAmount, measure,
  measures, quantity, nutrients, calories, date, mealTypeID
"""


def as_uuid(blob):
    """Ids are stored as the raw 16 bytes; the intents want the string form."""
    if blob and len(bytes(blob)) == 16:
        return str(uuid.UUID(bytes=bytes(blob))).upper()
    return None


def as_food(row):
    unit, value = measure_of(row)
    d = {"name": row["name"], "brand": row["brandOwner"], "barcode": row["barcode"],
         "food_id": row["foodID"], "entry_id": as_uuid(row["entryID"]),
         "unit": unit, "unit_quantity": value, "quantity": row["quantity"]}
    # The measure dict itself, not just its unit and size: FoodNoms' Log intent
    # takes a measure as a JSON document that is exactly this, so anything
    # generating an action needs the whole thing. `measures` is every portion the
    # food offers, which is how a recipe asks for "in fl oz" rather than "in cups".
    try:
        d["measure"] = json.loads(row["measure"] or "{}") or None
    except (ValueError, TypeError):
        d["measure"] = None
    try:
        d["measures"] = json.loads(row["measures"] or "[]") or []
    except (ValueError, TypeError):
        d["measures"] = []
    d.update(nutrients(row))
    return d


def catalog(con, min_count=1, since=None):
    """One row per distinct food, the most recent logging taken as canonical.

    Units, serving sizes and macros drift as brands reformulate, so the latest
    entry describes what is actually in the cupboard now. The count that comes
    with it is a good proxy for how much a food matters.
    """
    where, params = "WHERE name IS NOT NULL", []
    if since:
        where += " AND date >= ?"
        params.append(since)
    rows = con.execute(f"""
      SELECT {ENTRY_COLS}, cnt, last_logged FROM (
        SELECT *, COUNT(*) OVER (PARTITION BY COALESCE(foodID, name)) cnt,
               MAX(date) OVER (PARTITION BY COALESCE(foodID, name)) last_logged,
               ROW_NUMBER() OVER (PARTITION BY COALESCE(foodID, name)
                                  ORDER BY date DESC) rn
        FROM foodEntryRecord {where})
      WHERE rn = 1 AND cnt >= ?
      ORDER BY cnt DESC, name
    """, params + [min_count]).fetchall()
    out = []
    for r in rows:
        d = as_food(r)
        d["count"] = r["cnt"]
        d["last_logged"] = r["last_logged"]
        out.append(d)
    return out


def search(con, term):
    t = term.lower()
    if t.startswith("barcode:"):
        key, val = "barcode", t.split(":", 1)[1]
    elif t.startswith("id:"):
        key, val = "food_id", term.split(":", 1)[1]
    else:
        key, val = None, t
    hits = []
    for f in catalog(con):
        if key == "food_id":
            # Ids are matched on their tail as well as in full. The old store
            # kept `service` and `serviceID` apart, so anything pinned against
            # it says `usda:789692` where the live store says
            # `foodnoms:usda:789692` — the same food, and worth still finding.
            fid = f.get("food_id") or ""
            if fid == val or fid.endswith(":" + val):
                hits.append(f)
        elif key:
            if (f.get(key) or "") == val:
                hits.append(f)
        elif val in (f["name"] or "").lower():
            hits.append(f)
    return hits


UNIX_EPOCH_JD = 2440587.5


def julian_day(when):
    """FoodNoms' own key for a calendar day, as a Julian day number."""
    d = datetime.strptime(when, "%Y-%m-%d").date()
    return (d - date(1970, 1, 1)).days + UNIX_EPOCH_JD


def day(con, when):
    """A day's log. Entries belonging to a saved meal or recipe are excluded —
    they are components of a stored item, not separate things eaten.

    Filtered on the `day` column, not on `date`. Dates are stored in UTC, so an
    evening entry in Vancouver lands on the following UTC date; a date-range
    window would take yesterday evening and drop this evening. The `day` column
    is the app's own local-day key and is what the log screen groups by.
    """
    rows = con.execute(f"""
      SELECT {ENTRY_COLS} FROM foodEntryRecord
      WHERE day = ? AND collectionEditID IS NULL
      ORDER BY date
    """, (julian_day(when),)).fetchall()
    entries = []
    for r in rows:
        d = as_food(r)
        d["date"] = r["date"]
        entries.append(d)
    totals = {k: round(sum(e.get(k) or 0 for e in entries), 1)
              for k in ("calories", "protein", "carbs", "fat", "fiber", "sugars", "sodium")}
    return {"date": when, "totals": totals, "entries": entries}


# collectionType 2 is a saved Meal, 3 is a Recipe.
MEAL, RECIPE = 2, 3


def meals(con, name=None, kind=MEAL):
    out = []
    for c in con.execute("""SELECT id, collectionID, collectionEditID, name
                            FROM foodCollectionRecord WHERE collectionType = ?
                            ORDER BY name""", (kind,)):
        if name and name.lower() not in (c["name"] or "").lower():
            continue
        items = [as_food(r) for r in con.execute(
            f"SELECT {ENTRY_COLS} FROM foodEntryRecord WHERE collectionEditID = ? "
            "ORDER BY collectionSortIndex", (c["collectionEditID"],))]
        blob = c["collectionID"]
        # The id is stored as the raw 16 bytes of a UUID; FoodNoms' LogIntent
        # references a saved meal by that UUID in its canonical string form.
        meal_id = as_uuid(blob)
        out.append({"name": c["name"], "meal_id": meal_id, "items": items})
    return out


def parse_when(text):
    """Normalise a user-supplied date for the log intent.

    The intent takes a Date, and Shortcuts coerces the text token it is handed,
    so what matters is handing it something unambiguous. A bare date logs at
    noon rather than midnight: FoodNoms buckets an entry by its local day, and
    midnight is the boundary where a timezone offset moves it to the day before.
    """
    text = (text or "").strip()
    for fmt in ("%Y-%m-%d %H:%M", "%Y-%m-%dT%H:%M", "%Y-%m-%d %H:%M:%S",
                "%Y-%m-%dT%H:%M:%S"):
        try:
            return datetime.strptime(text, fmt).strftime("%Y-%m-%d %H:%M:%S")
        except ValueError:
            pass
    try:
        return datetime.strptime(text, "%Y-%m-%d").replace(
            hour=12).strftime("%Y-%m-%d %H:%M:%S")
    except ValueError:
        raise argparse.ArgumentTypeError(
            f"not a date this understands: {text!r}. Use YYYY-MM-DD or "
            "'YYYY-MM-DD HH:MM'.")


def food_entity_id(food_id):
    """The `foodEntry` identifier LogIntent wants: a document, not an id.

    It names the service the food came from and its id within that service —
    `foodNoms` for anything out of FoodNoms' database, `manualEntry` for a food
    created in the app — and it is what keeps a re-logged entry the same food,
    barcode and all, rather than a name with macros attached.
    """
    if (food_id or "").startswith("local:"):
        ident, service = food_id[len("local:"):], "manualEntry"
    elif (food_id or "").startswith("foodnoms:"):
        ident, service = food_id[len("foodnoms:"):], "foodNoms"
    else:
        ident, service = food_id, "foodNoms"
    return json.dumps({"value": {"foodID": {"_0": {"serviceID": ident,
                                                   "service": service}}}},
                      separators=(",", ":"))


def measure_entity_id(measure):
    """The `foodMeasure` identifier: the store's own measure dictionary, wrapped.

    Never invented — taken verbatim off the entry being replaced, so the portion
    the quantity counts is the same portion it counted before.
    """
    return json.dumps({"value": measure}, separators=(",", ":"))


def utc_to_local(stamp):
    """A stored entry timestamp, as local wall-clock time.

    `foodEntryRecord.date` is UTC; everything that writes back through an intent
    is interpreted as local. Converting is the difference between an edit that
    leaves an entry where it was and one that slides it across a day boundary.
    """
    txt = (stamp or "")[:19].replace("T", " ")
    try:
        naive = datetime.strptime(txt, "%Y-%m-%d %H:%M:%S")
    except ValueError:
        return txt
    return (naive.replace(tzinfo=timezone.utc)
            .astimezone()
            .strftime("%Y-%m-%d %H:%M:%S"))


def ensure_app_running(timeout=20):
    """Launch FoodNoms and wait for it, before any intent is dispatched.

    An intent dispatched at a FoodNoms that is not running fails silently: the
    bridge accepts the request, `shortcuts run` never returns, and the entry
    never lands — indistinguishable from the known does-not-return case. Nine
    backdated meal entries were lost this way. Launching is therefore step 0 of
    every write, not something the caller is trusted to have done.

    `-gj` launches in the background without stealing focus or a window.
    """
    if subprocess.run(["pgrep", "-ix", "Foodnoms"], capture_output=True).returncode == 0:
        return True
    subprocess.run(["open", "-gj", "-b", BUNDLE], capture_output=True)
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if subprocess.run(["pgrep", "-ix", "Foodnoms"], capture_output=True).returncode == 0:
            time.sleep(2)  # the process exists before its intents answer
            return True
        time.sleep(0.5)
    return False


def call_bridge(command, timeout=90, **params):
    """Dispatch one App Intent through the bridge Shortcut.

    macOS cannot invoke another app's App Intent directly, so a Shortcut is the
    only supported write path. Some FoodNoms intents complete the write and then
    do not return — the entry lands, `shortcuts run` simply never exits — so
    this bounds the wait rather than hanging the caller forever.

    The bound has to be generous, because the timeout does not merely stop
    waiting: it pkills `shortcuts run`, and a write still in flight dies with
    it. At 25s that lost every log while reporting the ambiguous "the intent did
    not return", which reads like the known does-not-return case and is instead
    this tool killing its own write. A cold FoodNoms takes well over 30s.
    """
    if not ensure_app_running():
        sys.exit("FoodNoms would not launch; the intent would fail silently.")
    payload = {"command": command}
    payload.update({k: v for k, v in params.items() if v is not None})
    tmp = tempfile.mkdtemp(prefix="foodnomsctl.")
    req, res = os.path.join(tmp, "request.json"), os.path.join(tmp, "result.txt")
    try:
        with open(req, "w") as fh:
            json.dump(payload, fh)
        proc = subprocess.run(["shortcuts", "run", BRIDGE, "-i", req, "-o", res],
                              capture_output=True, text=True, timeout=timeout)
        if proc.returncode != 0:
            err = (proc.stderr or "").strip()
            if "not find" in err.lower():
                sys.exit(f"{err}\nInstall the bridge: ./foodnomsctl-bridge --publish")
            sys.exit(err or f"shortcuts run failed ({proc.returncode})")
    except subprocess.TimeoutExpired:
        subprocess.run(["pkill", "-f", f"shortcuts run {BRIDGE}"], capture_output=True)
        return None
    finally:
        out = ""
        if os.path.exists(res):
            with open(res, encoding="utf-8", errors="replace") as fh:
                out = fh.read().strip()
        shutil.rmtree(tmp, ignore_errors=True)
    return out


def doctor():
    print("foodnomsctl doctor\n")
    store = find_store()
    if not store:
        print("  [FAIL] no FoodNoms store found in any sandbox container")
        print("         Is FoodNoms installed, and has it been opened at least once?")
        return 1
    print(f"  [OK]   store {store}")
    print(f"         {os.path.getsize(store) / 1_048_576:.1f} MB, modified "
          f"{datetime.fromtimestamp(os.path.getmtime(store)):%Y-%m-%d %H:%M}")

    for old in LEGACY:
        if os.path.exists(old):
            print(f"  [note] ignoring abandoned store {old}")

    try:
        con = connect(store)
        entries = con.execute("SELECT COUNT(*) FROM foodEntryRecord").fetchone()[0]
        newest = con.execute("SELECT MAX(date) FROM foodEntryRecord").fetchone()[0]
        foods = len(catalog(con))
        saved = len(meals(con))
    except sqlite3.Error as e:
        print(f"  [FAIL] schema not as expected: {e}")
        print("         FoodNoms may have migrated its database again.")
        return 1
    print(f"  [OK]   {entries} logged entries, newest {newest}")
    print(f"  [OK]   {foods} distinct foods")
    print(f"  [OK]   {saved} saved meals")

    installed = subprocess.run(["shortcuts", "list"], capture_output=True, text=True)
    if BRIDGE in (installed.stdout or ""):
        print(f'  [OK]   write path: "{BRIDGE}" installed')
    else:
        print(f'  [WARN] write path: "{BRIDGE}" not installed — reads work, writes')
        print("         will fail. Build and import it: ./foodnomsctl-bridge --publish")
    return 0


def fmt_food(f, indent=""):
    q = f"{f['quantity']:g}" if f.get("quantity") is not None else "?"
    unit = f.get("unit") or ""
    uq = f.get("unit_quantity")
    if uq and uq != 1:
        unit = f"{uq:g} {unit}"
    macro = f"{f.get('protein') or 0:.0f}p {f.get('calories') or 0:.0f}kcal"
    return f"{indent}{f['name']}  [{q} × {unit}]  {macro}"


def main():
    ap = argparse.ArgumentParser(prog="foodnomsctl", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--json", action="store_true")
    jsonopt = argparse.ArgumentParser(add_help=False)
    # SUPPRESS, not the default False: a subparser applies its own defaults over
    # the namespace, so a plain store_true here silently un-sets a --json given
    # before the subcommand.
    jsonopt.add_argument("--json", action="store_true", default=argparse.SUPPRESS)
    sub = ap.add_subparsers(
        dest="cmd", required=True,
        parser_class=lambda **kw: argparse.ArgumentParser(parents=[jsonopt], **kw))

    c = sub.add_parser("catalog"); c.add_argument("--min-count", type=int, default=1)
    c.add_argument("--since")
    s = sub.add_parser("search"); s.add_argument("term")
    r = sub.add_parser("resolve"); r.add_argument("term")
    d = sub.add_parser("day"); d.add_argument("when", nargs="?", default=date.today().isoformat())
    m = sub.add_parser("meals"); m.add_argument("name", nargs="?")
    rm = sub.add_parser("resolve-meal"); rm.add_argument("name")
    sub.add_parser("doctor")

    lg = sub.add_parser("log", help="log a food by name with macros")
    lg.add_argument("name")
    lg.add_argument("--date", dest="date", type=parse_when,
                    help="when to log it: YYYY-MM-DD, 'YYYY-MM-DD HH:MM', or an "
                         "ISO-8601 timestamp (default now). Correcting an "
                         "earlier day is the point of this flag.")
    for flag, dest in (("--calories", "energyCalories"), ("--protein", "protein"),
                       ("--carbs", "carbs"), ("--fat", "fat"), ("--fiber", "fiber"),
                       ("--sugars", "sugars"), ("--sodium", "sodium")):
        lg.add_argument(flag, dest=dest, type=float)
    cf = sub.add_parser("create-food", help="create a food in the library")
    cf.add_argument("name")
    cf.add_argument("--brand"); cf.add_argument("--barcode")
    cf.add_argument("--serving-size", dest="servingSize")
    for flag, dest in (("--calories", "energyCalories"), ("--protein", "protein"),
                       ("--carbs", "carbs"), ("--fat", "fat")):
        cf.add_argument(flag, dest=dest, type=float)
    sub.add_parser("goal", help="today's goal")
    dl = sub.add_parser("delete", help="delete a logged entry by name or entry id")
    dl.add_argument("target", help="entry id, or a name to match in a day's log")
    dl.add_argument("--on", default=date.today().isoformat(),
                    help="which day to search when matching by name (default today)")
    ed = sub.add_parser("edit", help="correct a logged entry's macros or its day")
    ed.add_argument("target", help="entry id, or a name to match in a day's log")
    ed.add_argument("--on", default=date.today().isoformat(),
                    help="which day the entry is currently on (default today)")
    ed.add_argument("--to-date", dest="to_date", type=parse_when,
                    help="move it to this day; omit to leave it where it is")
    ed.add_argument("--scale", type=float,
                    help="multiply the portion by this — 0.5 for half of what "
                         "was logged. Macros follow the portion, because the "
                         "food and its measure are kept.")
    ed.add_argument("--quantity", type=float,
                    help="set the portion outright, in the measure the entry "
                         "already uses")
    dl.add_argument("--all", action="store_true",
                    help="delete every entry that matches, rather than refusing "
                         "to guess between them")

    a = ap.parse_args()
    if a.cmd == "doctor":
        sys.exit(doctor())

    if a.cmd == "delete":
        con = connect()
        entries = day(con, a.on)["entries"]
        hits = [e for e in entries
                if a.target.upper() == (e["entry_id"] or "").upper()
                or a.target.lower() in (e["name"] or "").lower()]
        if not hits:
            sys.exit(f"no entry matching {a.target!r} in the log for {a.on}")
        if len(hits) > 1 and not a.all:
            print(f"{len(hits)} entries match {a.target!r} in the log for {a.on}:",
                  file=sys.stderr)
            for h in hits:
                print(f"  {h['name']}  {h['entry_id']}", file=sys.stderr)
            sys.exit("refusing to guess — name the entry id, or pass --all")

        # The bridge deletes by position in GetFoodEntriesIntent's own output,
        # which is not this list: the intent returns fewer entries than the store
        # holds, so an index taken from SQL is off by however many it dropped.
        # Which ones it drops is not documented and not worth inferring — a day
        # of HidrateSpark bottle logs vanished while a `Water` food on another
        # day came back. So ask for the list and resolve against it. Deleting is
        # permanent, so a name the intent does not return is a stop, not a
        # best guess.
        when = f"{a.on} 12:00:00"
        listed = call_bridge("entries", date=when)
        if not listed:
            sys.exit("delete: the bridge returned no entries for that day. "
                     "Is the build installed? `foodnomsctl doctor`.")
        names = [n for n in (listed or "").splitlines() if n.strip()]

        # Deleting shifts every later position, so work from the back.
        targets = []
        for h in hits if a.all else hits[:1]:
            matches = [i for i, n in enumerate(names) if n == h["name"]]
            if not matches:
                sys.exit(f"delete: {h['name']!r} is in the store for {a.on} but not "
                         "in what the intent returns for that day, so there is no "
                         "position to delete. Delete it in FoodNoms.")
            targets.append((matches.pop(0), h))
        for idx, h in sorted(targets, reverse=True):
            call_bridge("delete", date=when, index=idx + 1)
            still = [e for e in day(connect(), a.on)["entries"]
                     if e["entry_id"] == h["entry_id"]]
            if still:
                sys.exit(f"delete: {h['name']} is still in the log for {a.on}. "
                         "The intent accepted the request without acting on it.")
            print(f"deleted {h['name']}")
        return

    if a.cmd == "edit":
        # FoodNoms has no edit-a-logged-entry intent among its 45 —
        # EditFoodIntent edits a library food's definition, not an entry in a day
        # — so an edit is delete plus re-log. The re-log goes through LogIntent
        # with the food and measure the entry already carried, not through quick
        # entry, so the corrected entry is the same food: same barcode, same
        # portion, same everything but the number that was wrong.
        con = connect()
        hits = [e for e in day(con, a.on)["entries"]
                if a.target.upper() == (e["entry_id"] or "").upper()
                or a.target.lower() in (e["name"] or "").lower()]
        if not hits:
            sys.exit(f"no entry matching {a.target!r} in the log for {a.on}")
        if len(hits) > 1:
            print(f"{len(hits)} entries match {a.target!r} in the log for {a.on}:",
                  file=sys.stderr)
            for h in hits:
                print(f"  {h['name']}  {h['entry_id']}  {h['quantity']:g} x "
                      f"{h.get('unit_quantity') or 1:g}{h.get('unit') or ''}",
                      file=sys.stderr)
            sys.exit("refusing to guess — name the entry id")
        e = hits[0]

        if a.quantity is not None:
            qty = a.quantity
        elif a.scale is not None:
            qty = (e.get("quantity") or 0) * a.scale
        else:
            sys.exit("edit: nothing to change — give --scale or --quantity")
        if qty <= 0:
            sys.exit(f"edit: quantity would be {qty:g}. To remove it, use `delete`.")

        measure = e.get("measure")
        if not measure:
            sys.exit(f"edit: {e['name']} carries no measure, so a re-log could "
                     "only guess the portion. Edit it in FoodNoms.")

        # `date` is stored in UTC and every intent reads what it is handed as
        # local time. Passing the stored value straight back moves the entry by
        # the UTC offset — seven hours in Vancouver, enough to push a late entry
        # onto the next day and quietly change two days' totals.
        when = a.to_date or utc_to_local(e["date"])
        target_day = when[:10]

        idx_when = f"{a.on} 12:00:00"
        listed = call_bridge("entries", date=idx_when)
        names = [n for n in (listed or "").splitlines() if n.strip()]
        matches = [i for i, n in enumerate(names) if n == e["name"]]
        if not matches:
            sys.exit(f"edit: {e['name']!r} is not in what the intent returns for "
                     f"{a.on}, so there is no position to delete. Edit it in "
                     "FoodNoms.")

        # Delete first. Re-logging first and then failing to delete would double
        # the day, which is a worse state to land in than a missing entry.
        call_bridge("delete", date=idx_when, index=matches[0] + 1)
        if [x for x in day(connect(), a.on)["entries"] if x["entry_id"] == e["entry_id"]]:
            sys.exit(f"edit: could not delete {e['name']}; nothing was changed.")

        unit_name = (measure.get("descriptionText")
                     or measure.get("unit") or "serving")
        call_bridge("log-food", date=when, quantity=f"{qty:g}",
                    foodIdentifier=food_entity_id(e.get("food_id")),
                    foodName=e["name"],
                    measureIdentifier=measure_entity_id(measure),
                    measureName=unit_name)

        after = [x for x in day(connect(), target_day)["entries"]
                 if x["name"] == e["name"] and abs((x.get("quantity") or 0) - qty) < 1e-6]
        if not after:
            sys.exit(f"edit: deleted {e['name']} but the re-log did not land on "
                     f"{target_day}. Re-add it in FoodNoms: {qty:g} x {unit_name}.")
        print(f"{e['name']}: {e['quantity']:g} → {qty:g} x {unit_name}"
              + (f", moved to {target_day}" if target_day != a.on else ""))
        return

    if a.cmd in ("log", "create-food", "goal"):
        fields = {k: v for k, v in vars(a).items() if k not in ("cmd", "json")}
        out = call_bridge(a.cmd, **fields)
        if out is None:
            # The intent wrote and then did not hand control back. Say so rather
            # than reporting a failure that did not happen.
            print(f"{a.cmd}: submitted; the intent did not return. "
                  "Verify with `foodnomsctl day`.", file=sys.stderr)
            return
        print(json.dumps({"command": a.cmd, "result": out}, indent=2) if a.json else out)
        return

    con = connect()

    if a.cmd == "catalog":
        res = catalog(con, a.min_count, a.since)
        if a.json:
            print(json.dumps(res, indent=2)); return
        for f in res:
            print(f"{f['count']:>4}  {fmt_food(f)}")
    elif a.cmd in ("search", "resolve"):
        res = search(con, a.term)
        if a.cmd == "resolve":
            if not res:
                sys.exit(f"no FoodNoms food matches: {a.term}")
            res = res[:1]
        if a.json:
            print(json.dumps(res, indent=2)); return
        for f in res:
            print(f"{f['count']:>4}  {fmt_food(f)}")
            print(f"      {f['food_id']}"
                  + (f"  barcode {f['barcode']}" if f.get("barcode") else ""))
    elif a.cmd == "day":
        res = day(con, a.when)
        if a.json:
            print(json.dumps(res, indent=2)); return
        t = res["totals"]
        print(f"{res['date']}  —  {t['calories']:.0f} kcal · {t['protein']:.0f}g protein "
              f"· {t['carbs']:.0f}g carbs · {t['fat']:.0f}g fat")
        for e in res["entries"]:
            print(fmt_food(e, "  "))
    elif a.cmd == "resolve-meal":
        res = [mm for mm in meals(con, a.name) if mm["meal_id"]]
        if not res:
            sys.exit(f"no saved FoodNoms meal matches: {a.name}")
        exact = [mm for mm in res if mm["name"].lower() == a.name.lower()]
        res = (exact or res)[:1]
        if a.json:
            print(json.dumps(res[0], indent=2)); return
        print(f"{res[0]['name']}  {res[0]['meal_id']}")
    elif a.cmd == "meals":
        res = meals(con, a.name)
        if a.json:
            print(json.dumps(res, indent=2)); return
        for mm in res:
            print(f"{mm['name']}  ({len(mm['items'])} items)  {mm['meal_id'] or ''}")
            for it in mm["items"]:
                print(fmt_food(it, "    "))


if __name__ == "__main__":
    main()
