def enqueue(command, params):
    os.makedirs(PENDING, exist_ok=True)
    req = {"command": command, "queued": datetime.now().isoformat(timespec="seconds"),
           "params": {k: v for k, v in params.items() if v is not None}}
    name = f"{datetime.now():%Y%m%dT%H%M%S}-{uuid.uuid4().hex[:8]}.json"
    path = os.path.join(PENDING, name)
    tmp = path + ".part"
    with open(tmp, "w") as fh:
        json.dump(req, fh, indent=2)
    # Rename into place so a drain never reads a half-written request.
    os.rename(tmp, path)
    return path


def queued():
    if not os.path.isdir(PENDING):
        return []
    return sorted(os.path.join(PENDING, n) for n in os.listdir(PENDING)
                  if n.endswith(".json"))


def entry_exists(command, params):
    """Whether the store already holds what this request would write.

    This is what replaces waiting on `shortcuts run`. The log intent completes
    the write and then never hands control back, so the only signal that a write
    succeeded is the entry appearing — and once it has, there is nothing left to
    wait for.
    """
    if command != "log":
        return False
    name = params.get("name")
    when = (params.get("date") or "")[:10] or date.today().isoformat()
    try:
        con = connect()
        return any((e["name"] or "") == name for e in day(con, when)["entries"])
    except (sqlite3.Error, SystemExit):
        return False


def dispatch(command, params, settle=45):
    """Run one queued request, returning as soon as the store confirms it.

    The old code waited a flat 90s for a return value that never comes, so nine
    items cost thirteen minutes of pure waiting. Polling the store instead costs
    a couple of seconds per item, and the flat wait survives only as the cap for
    a write that never appears at all.
    """
    if not ensure_app_running():
        return False, "FoodNoms would not launch"
    tmp = tempfile.mkdtemp(prefix="foodnomsctl.")
    req = os.path.join(tmp, "request.json")
    res = os.path.join(tmp, "result.txt")
    payload = {"command": command}
    payload.update(params)
    try:
        with open(req, "w") as fh:
            json.dump(payload, fh)
        proc = subprocess.Popen(["shortcuts", "run", BRIDGE, "-i", req, "-o", res],
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                stdin=subprocess.DEVNULL, text=True)
        deadline = time.monotonic() + settle
        while time.monotonic() < deadline:
            if proc.poll() is not None:
                err = (proc.stderr.read() or "").strip()
                if proc.returncode != 0:
                    return False, err or f"shortcuts run failed ({proc.returncode})"
                break
            if entry_exists(command, params):
                break
            time.sleep(1)
        else:
            proc.kill()
            # The cap is not proof of failure — it is the point at which
            # waiting stopped. A locked screen makes every write slower, and a
            # request declared failed here stays pending for the next drain to
            # fire again, which is how a lunch logged once appeared twice. So
            # give the store the same grace the success path gets before
            # concluding anything.
            for _ in range(10):
                time.sleep(1)
                if entry_exists(command, params):
                    return True, ""
            return False, "no entry appeared before the cap"
        # A write that has landed leaves `shortcuts run` hanging with nothing
        # left to do; killing it here is what the flat timeout used to do at 90s.
        if proc.poll() is None:
            proc.kill()
        # Settle before declaring failure. FoodNoms commits through its own WAL
        # and the snapshot taken here can be a beat behind it, so a write that
        # has in fact landed reads as missing for a second or two. Reporting
        # failure then leaves the request pending, the agent retries it, and the
        # meal is logged twice — which is exactly how two Probe entries appeared
        # ten seconds apart. A missing entry is cheap to re-check; a duplicate
        # costs a manual delete.
        if command == "log":
            for _ in range(8):
                if entry_exists(command, params):
                    break
                time.sleep(1)
            else:
                return False, "the intent accepted the request without writing"
        out = ""
        if os.path.exists(res):
            with open(res, encoding="utf-8", errors="replace") as fh:
                out = fh.read().strip()
        return True, out
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


LOCK = os.path.join(SPOOL, "flush.lock")


def flush(verbose=True, only=None):
    """Drain the queue, one drainer at a time.

    `only` limits the drain to a single request. That matters more than it
    looks: `log` used to enqueue and then drain everything, so a request whose
    write had landed but whose verification lagged behind FoodNoms\' WAL stayed
    pending and was re-dispatched by the NEXT log\'s flush — nine sequential
    logs gave eight chances to double-write, which is exactly what happened to
    a nine-item meal. A log now drains only what it just queued.

    The exclusive lock is not a nicety. The launchd agent drains on an interval
    AND on any change to the queue directory, so a drain started by hand runs
    beside one started by the agent; both see the same pending request, both
    dispatch it, and neither has landed yet when the other checks. That turned
    nine queued items into ninety entries. Claiming a request is therefore
    serialized, and a second drainer leaves rather than waiting — whatever it
    would have done, the drainer holding the lock is already doing.

    A no-op, and a fast one, while the screen is locked.
    """
    items = [only] if only else queued()
    items = [p for p in items if os.path.exists(p)]
    if not items:
        return 0, 0
    os.makedirs(SPOOL, exist_ok=True)
    lock = open(LOCK, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        if verbose:
            print("another drain is already running", file=sys.stderr)
        return 0, len(items)
    try:
        return _flush(items, verbose)
    finally:
        fcntl.flock(lock, fcntl.LOCK_UN)
        lock.close()


def _flush(items, verbose):
    # No lock check here. Shortcuts runs while the screen is locked — verified
    # with the lock state read before, between and after runs — and what looked
    # like "locked blocks runs" was three other things: `shortcuts run` reading
    # stdin to EOF when given no -i, a shortcut showing its result in a dialog,
    # and a picker left pending by an earlier run. Only IMPORTING a Shortcut
    # needs the screen, for its preview. The queue stays as the safety net: a
    # write that does not land stays pending.
    os.makedirs(DONE, exist_ok=True)
    ok = 0
    for path in items:
        # Claim the request by moving it aside before doing anything with it,
        # so a crash mid-write leaves it claimed rather than pending — a
        # duplicate meal is worse to undo than a missing one is to re-enter.
        claim = path + ".claimed"
        try:
            os.rename(path, claim)
            with open(claim) as fh:
                req = json.load(fh)
        except (OSError, ValueError):
            continue
        command, params = req.get("command"), req.get("params", {})
        if entry_exists(command, params):
            # Already in the store — a previous run wrote it and died before it
            # could clear the queue. Retrying would double-log.
            os.rename(claim, os.path.join(DONE, os.path.basename(path)))
            ok += 1
            continue
        good, detail = dispatch(command, params)
        if good:
            os.rename(claim, os.path.join(DONE, os.path.basename(path)))
            ok += 1
            if verbose:
                print(f"logged {params.get('name', command)}")
        else:
            # Not written, so put it back for the next drain.
            os.rename(claim, path)
            if verbose:
                print(f"still queued: {params.get('name', command)} — {detail}",
                      file=sys.stderr)
    return ok, len(queued())


def main():
    ap = argparse.ArgumentParser(prog="foodnomsctl", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--version", action="version",
                    version=f"foodnomsctl {__version__}")
    jsonopt = argparse.ArgumentParser(add_help=False)
    # SUPPRESS, not the default False: a subparser applies its own defaults over
    # the namespace, so a plain store_true here silently un-sets a --json given
    # before the subcommand.
    jsonopt.add_argument("--json", action="store_true", default=argparse.SUPPRESS)
    sub = ap.add_subparsers(
        dest="cmd", required=True,
        parser_class=lambda **kw: argparse.ArgumentParser(parents=[jsonopt], **kw))

    c = sub.add_parser("catalog"); c.add_argument("--min-count", type=int, default=1)
    c.add_argument("--since")
    s = sub.add_parser("search"); s.add_argument("term")
    r = sub.add_parser("resolve"); r.add_argument("term")
    d = sub.add_parser("day"); d.add_argument("when", nargs="?", default=date.today().isoformat())
    d.add_argument("--components", action="store_true",
                   help="include the items of saved meals and recipes. Logging a "
                        "meal writes one row per item and none named after the "
                        "meal, so this is how to see that such a write landed. "
                        "Totals double-count with it on, and are omitted.")
    m = sub.add_parser("meals"); m.add_argument("name", nargs="?")
    rm = sub.add_parser("resolve-meal"); rm.add_argument("name")
    sub.add_parser("doctor")
    sub.add_parser("barcodes", help="every known barcode and the food behind it")

    lg = sub.add_parser("log", help="log a food by name with macros")
    lg.add_argument("--queue-only", action="store_true",
                    help="queue without attempting to write")
    lg.add_argument("--meal", help="breakfast, lunch, dinner or snack. Omitted, "
                                   "FoodNoms picks one and often picks wrong")
    lg.add_argument("name")
    lg.add_argument("--date", dest="date", type=parse_when,
                    help="when to log it: YYYY-MM-DD, 'YYYY-MM-DD HH:MM', or an "
                         "ISO-8601 timestamp (default now). Correcting an "
                         "earlier day is the point of this flag.")
    for flag, dest in (("--calories", "energyCalories"), ("--protein", "protein"),
                       ("--carbs", "carbs"), ("--fat", "fat"), ("--fiber", "fiber"),
                       ("--sugars", "sugars"), ("--sodium", "sodium")):
        lg.add_argument(flag, dest=dest, type=float)
    cf = sub.add_parser("create-food", help="create a food in the library")
    cf.add_argument("--queue-only", action="store_true",
                    help="queue without attempting to write")
    cf.add_argument("name")
    cf.add_argument("--brand"); cf.add_argument("--barcode")
    cf.add_argument("--serving-size", dest="servingSize",
                    help='the label\'s serving, e.g. "1 capsule" or "2 softgels"')
    cf.add_argument("--serving-grams", dest="servingMetricAmount", type=float,
                    help="what that serving weighs, if the label says")
    for flag, dest in NUTRIENT_FLAGS:
        cf.add_argument(flag, dest=dest, type=float)
    sub.add_parser("goal", help="today's goal")
    sub.add_parser("flush", help="log everything queued, if the Mac can write")
    sub.add_parser("meal-types", help="the meal types, in the order the bridge picks them")
    dl = sub.add_parser("delete", help="delete a logged entry by name or entry id")
    dl.add_argument("target", help="entry id, or a name to match in a day's log")
    dl.add_argument("--on", default=date.today().isoformat(),
                    help="which day to search when matching by name (default today)")
    ed = sub.add_parser("edit", help="correct a logged entry's macros or its day")
    ed.add_argument("target", help="entry id, or a name to match in a day's log")
    ed.add_argument("--on", default=date.today().isoformat(),
                    help="which day the entry is currently on (default today)")
    ed.add_argument("--to-date", dest="to_date", type=parse_when,
                    help="move it to this day; omit to leave it where it is")
    ed.add_argument("--scale", type=float,
                    help="multiply the portion by this — 0.5 for half of what "
                         "was logged. Macros follow the portion, because the "
                         "food and its measure are kept.")
    ed.add_argument("--quantity", type=float,
                    help="set the portion outright, in the measure the entry "
                         "already uses")
    dl.add_argument("--all", action="store_true",
                    help="delete every entry that matches, rather than refusing "
                         "to guess between them")

    a = ap.parse_args()
    if a.cmd == "doctor":
        sys.exit(doctor())

    if a.cmd == "delete":
        con = connect()
        entries = day(con, a.on)["entries"]
        hits = [e for e in entries
                if a.target.upper() == (e["entry_id"] or "").upper()
                or a.target.lower() in (e["name"] or "").lower()]
        if not hits:
            sys.exit(f"no entry matching {a.target!r} in the log for {a.on}")
        if len(hits) > 1 and not a.all:
            print(f"{len(hits)} entries match {a.target!r} in the log for {a.on}:",
                  file=sys.stderr)
            for h in hits:
                print(f"  {h['name']}  {h['entry_id']}", file=sys.stderr)
            sys.exit("refusing to guess — name the entry id, or pass --all")

        # The bridge deletes by position in GetFoodEntriesIntent's own output,
        # which is not this list: the intent returns fewer entries than the store
        # holds, so an index taken from SQL is off by however many it dropped.
        # Which ones it drops is not documented and not worth inferring — a day
        # of HidrateSpark bottle logs vanished while a `Water` food on another
        # day came back. So ask for the list and resolve against it. Deleting is
        # permanent, so a name the intent does not return is a stop, not a
        # best guess.
        when = f"{a.on} 12:00:00"
        listed = call_bridge("entries", date=when)
        if not listed:
            sys.exit("delete: the bridge returned no entries for that day. "
                     "Is the build installed? `foodnomsctl doctor`.")
        names = [n for n in (listed or "").splitlines() if n.strip()]

        # Deleting shifts every later position, so work from the back.
        targets = []
        for h in hits if a.all else hits[:1]:
            matches = [i for i, n in enumerate(names) if n == h["name"]]
            if not matches:
                sys.exit(f"delete: {h['name']!r} is in the store for {a.on} but not "
                         "in what the intent returns for that day, so there is no "
                         "position to delete. Delete it in FoodNoms.")
            targets.append((matches.pop(0), h))
        # Sort on the index alone: a tuple sort falls through to comparing the
        # entry dicts when two targets share an index, and dicts do not order.
        for idx, h in sorted(targets, key=lambda t: t[0], reverse=True):
            call_bridge("delete", date=when, index=idx + 1)
            still = [e for e in day(connect(), a.on)["entries"]
                     if e["entry_id"] == h["entry_id"]]
            if still:
                sys.exit(f"delete: {h['name']} is still in the log for {a.on}. "
                         "The intent accepted the request without acting on it.")
            print(f"deleted {h['name']}")
        return

    if a.cmd == "edit":
        # FoodNoms has no edit-a-logged-entry intent among its 45 —
        # EditFoodIntent edits a library food's definition, not an entry in a day
        # — so an edit is delete plus re-log. The re-log goes through LogIntent
        # with the food and measure the entry already carried, not through quick
        # entry, so the corrected entry is the same food: same barcode, same
        # portion, same everything but the number that was wrong.
        con = connect()
        hits = [e for e in day(con, a.on)["entries"]
                if a.target.upper() == (e["entry_id"] or "").upper()
                or a.target.lower() in (e["name"] or "").lower()]
        if not hits:
            sys.exit(f"no entry matching {a.target!r} in the log for {a.on}")
        if len(hits) > 1:
            print(f"{len(hits)} entries match {a.target!r} in the log for {a.on}:",
                  file=sys.stderr)
            for h in hits:
                print(f"  {h['name']}  {h['entry_id']}  {h['quantity']:g} x "
                      f"{h.get('unit_quantity') or 1:g}{h.get('unit') or ''}",
                      file=sys.stderr)
            sys.exit("refusing to guess — name the entry id")
        e = hits[0]

        if a.quantity is not None:
            qty = a.quantity
        elif a.scale is not None:
            qty = (e.get("quantity") or 0) * a.scale
        else:
            sys.exit("edit: nothing to change — give --scale or --quantity")
        if qty <= 0:
            sys.exit(f"edit: quantity would be {qty:g}. To remove it, use `delete`.")

        measure = e.get("measure")
        if not measure:
            sys.exit(f"edit: {e['name']} carries no measure, so a re-log could "
                     "only guess the portion. Edit it in FoodNoms.")

        # `date` is stored in UTC and every intent reads what it is handed as
        # local time. Passing the stored value straight back moves the entry by
        # the UTC offset — seven hours in Vancouver, enough to push a late entry
        # onto the next day and quietly change two days' totals.
        when = a.to_date or utc_to_local(e["date"])
        target_day = when[:10]

        idx_when = f"{a.on} 12:00:00"
        listed = call_bridge("entries", date=idx_when)
        names = [n for n in (listed or "").splitlines() if n.strip()]
        matches = [i for i, n in enumerate(names) if n == e["name"]]
        if not matches:
            sys.exit(f"edit: {e['name']!r} is not in what the intent returns for "
                     f"{a.on}, so there is no position to delete. Edit it in "
                     "FoodNoms.")

        # Delete first. Re-logging first and then failing to delete would double
        # the day, which is a worse state to land in than a missing entry.
        call_bridge("delete", date=idx_when, index=matches[0] + 1)
        if [x for x in day(connect(), a.on)["entries"] if x["entry_id"] == e["entry_id"]]:
            sys.exit(f"edit: could not delete {e['name']}; nothing was changed.")

        unit_name = (measure.get("descriptionText")
                     or measure.get("unit") or "serving")
        call_bridge("log-food", date=when, quantity=f"{qty:g}",
                    foodIdentifier=food_entity_id(e.get("food_id")),
                    foodName=e["name"],
                    measureIdentifier=measure_entity_id(measure),
                    measureName=unit_name)

        # Poll, do not glance. The delete has already happened, so a re-log
        # that is merely slow must not be reported as lost — that is a deleted
        # entry and a message telling someone to retype it.
        after = []
        for _ in range(20):
            after = [x for x in day(connect(), target_day)["entries"]
                     if x["name"] == e["name"]
                     and abs((x.get("quantity") or 0) - qty) < 1e-6]
            if after:
                break
            time.sleep(1)
        if not after:
            # Still nothing: queue the re-log rather than lose it. The drain
            # retries on its own, and the entry comes back at the corrected
            # portion without anyone retyping it.
            # Macros scale with the portion: the entry carried what was eaten
            # at the old quantity, and the queued re-log is a quick entry with
            # no food behind it to recompute them.
            factor = qty / (e.get("quantity") or qty)
            scaled = {k: (round(v * factor, 1) if isinstance(v, (int, float)) else None)
                      for k, v in (("energyCalories", e.get("calories")),
                                   ("protein", e.get("protein")),
                                   ("carbs", e.get("carbs")),
                                   ("fat", e.get("fat")))}
            path = enqueue("log", {"name": e["name"], "date": when, **scaled})
            sys.exit(f"edit: deleted {e['name']} and the re-log has not landed yet. "
                     f"Queued as {os.path.basename(path)} — `foodnomsctl flush` "
                     f"retries it, and the queue agent does so on its own. "
                     f"It will come back as {qty:g} x {unit_name}.")
        print(f"{e['name']}: {e['quantity']:g} → {qty:g} x {unit_name}"
              + (f", moved to {target_day}" if target_day != a.on else ""))
        return

    if a.cmd == "meal-types":
        ms = meal_types(connect())
        if a.json:
            print(json.dumps(ms, indent=2)); return
        for m in ms:
            print(f"  {m['index']}  {m['name']:<12} id={m['id']}"
                  + ("  (disabled)" if m["disabled"] else ""))
        return

    if a.cmd == "flush":
        ok, left = flush()
        if a.json:
            print(json.dumps({"logged": ok, "queued": left}, indent=2))
        elif not ok and not left:
            print("nothing queued")
        else:
            print(f"logged {ok}, {left} still queued")
        return 0 if not left else 2

    if a.cmd == "goal":
        # A read, so there is nothing to queue: a goal fetched later is not the
        # same answer, and a stale one is worse than none.
        good, out = dispatch("goal", {})
        if not good:
            sys.exit(f"goal: {out}")
        print(json.dumps({"command": "goal", "result": out}, indent=2)
              if a.json else out)
        return

    if a.cmd in ("log", "create-food"):
        fields = {k: v for k, v in vars(a).items()
                  if k not in ("cmd", "json", "queue_only", "meal")}
        cmd = a.cmd
        if getattr(a, "meal", None):
            # A different branch entirely: mealType is entity-typed, so it is
            # reached by chaining GetMealTypeIntent rather than by a parameter.
            fields["meal_index"] = meal_index(connect(), a.meal)
            cmd = "log-meal"
        if a.cmd == "log":
            gap = missing_macros(fields)
            if gap:
                sys.exit(f"log needs {', '.join(gap)}: FoodNoms is configured to "
                         "require calories, protein, carbs and fat, and it asks "
                         "for a missing one in a dialog rather than failing — "
                         "which never returns on a headless run. Pass 0 if a "
                         "macro really is zero.")
        # Queued before it is attempted, so a write is never lost to a locked
        # screen, a crash, or a bridge that accepts and does nothing.
        path = enqueue(cmd, fields)
        if getattr(a, "queue_only", False):
            print(f"queued {os.path.basename(path)}")
            return
        ok, left = flush(verbose=False, only=path)
        if ok:
            print(f"logged {fields.get('name', cmd)}")
        else:
            print("queued — the write did not land. `foodnomsctl flush` retries; "
                  "the queue agent does so on its own.", file=sys.stderr)
        return

    con = connect()

    if a.cmd == "barcodes":
        res = barcodes(con)
        if a.json:
            print(json.dumps(res, indent=1)); return
        for code, f in sorted(res.items(), key=lambda kv: (kv[1]["name"] or "")):
            print(f'{code:>16}  {(f["name"] or "")[:38]:38s} {(f["brand"] or "")[:18]:18s} {f["food_id"]}')
        return

    if a.cmd == "catalog":
        res = catalog(con, a.min_count, a.since)
        if a.json:
            print(json.dumps(res, indent=2)); return
        for f in res:
            print(f"{f['count']:>4}  {fmt_food(f)}")
    elif a.cmd in ("search", "resolve"):
        res = search(con, a.term)
        if a.cmd == "resolve":
            if not res:
                sys.exit(f"no FoodNoms food matches: {a.term}")
            res = res[:1]
        if a.json:
            print(json.dumps(res, indent=2)); return
        for f in res:
            print(f"{f['count']:>4}  {fmt_food(f)}")
            print(f"      {f['food_id']}"
                  + (f"  barcode {f['barcode']}" if f.get("barcode") else ""))
    elif a.cmd == "day":
        res = day(con, a.when, components=a.components)
        if a.json:
            print(json.dumps(res, indent=2)); return
        t = res["totals"]
        if t:
            print(f"{res['date']}  —  {t['calories']:.0f} kcal · {t['protein']:.0f}g protein "
                  f"· {t['carbs']:.0f}g carbs · {t['fat']:.0f}g fat")
        else:
            print(f"{res['date']}  —  {len(res['entries'])} entries, meal and recipe "
                  "items included (no totals: they would double-count)")
        for e in res["entries"]:
            print(fmt_food(e, "  "))
    elif a.cmd == "resolve-meal":
        res = [mm for mm in meals(con, a.name) if mm["meal_id"]]
        if not res:
            sys.exit(f"no saved FoodNoms meal matches: {a.name}")
        exact = [mm for mm in res if mm["name"].lower() == a.name.lower()]
        res = (exact or res)[:1]
        if a.json:
            print(json.dumps(res[0], indent=2)); return
        print(f"{res[0]['name']}  {res[0]['meal_id']}")
    elif a.cmd == "meals":
        res = meals(con, a.name)
        if a.json:
            print(json.dumps(res, indent=2)); return
        for mm in res:
            print(f"{mm['name']}  ({len(mm['items'])} items)  {mm['meal_id'] or ''}")
            for it in mm["items"]:
                print(fmt_food(it, "    "))


if __name__ == "__main__":
    main()
